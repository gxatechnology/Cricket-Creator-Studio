# =============================================================================
# Cricket Creator Studio — Environment Configuration
# =============================================================================

# --- Supabase Authentication (Browser / Vite Public) ---
# Safe for client exposure. Used for Google OAuth via Supabase PKCE flow.
# Get these from your Supabase project: Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"

# --- Server-Side Authentication & Port Settings ---
PORT=3000

# Set REQUIRE_AUTH=true in hosted/multi-user production to enforce Supabase JWT verification
# on all render jobs. When false (default), local development allows loopback guest mode.
REQUIRE_AUTH=false

# Optional server-side Supabase keys (defaults to VITE_SUPABASE_* if omitted)
# SUPABASE_URL="https://your-project-id.supabase.co"
# SUPABASE_ANON_KEY="your-anon-publishable-key"

# --- Gemini AI Trivia & Content Assist (Optional) ---
# GEMINI_API_KEY: Required for live Gemini AI content assist calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Deployment URL ---
# APP_URL: The URL where this applet is hosted (e.g. http://localhost:3000)
APP_URL="http://localhost:3000"
